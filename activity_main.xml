<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#111111">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E1E1E"
        android:padding="20dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💪 WORKOUT WIDGET"
            android:textColor="#FFCC00"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"/>

        <TextView
            android:id="@+id/tv_current_step"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current Step: 1 of 10"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:paddingTop="4dp"/>

    </LinearLayout>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center">

        <Button
            android:id="@+id/btn_reset_workout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↺ Reset"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_add_exercise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Add"
            android:backgroundTint="#FFCC00"
            android:textColor="#111111"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_restore_defaults"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⟳ Defaults"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

    <!-- Exercise list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_exercises"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false"/>

</LinearLayout>
